                      </button>
                      <span className={`w-4 text-center font-bold ${isSelected ? 'text-white' : 'text-slate-600'}`}>
                        {count}
                      </span>
                      <button 
                        onClick={() => handleIncrement(role.id)}
                        className="w-7 h-7 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors text-white"
                      >
                        <Plus className="w-3 h-3" />
                      </button>
                    </div>
                  </div>
                );
              })}
            </div>

            {/* Sticky Footer */}
            <div className="absolute bottom-0 left-0 w-full p-6 bg-gradient-to-t from-slate-950 via-slate-950 to-transparent">
              <div className="bg-slate-900 border border-white/10 rounded-2xl p-4 shadow-2xl flex flex-col space-y-4">
                <div className="flex justify-between items-center text-sm font-medium">
                  <span className="text-slate-400">Rôles sélectionnés</span>
                  <span className={`${totalSelectedRoles === playerCount ? 'text-green-400' : 'text-red-400'}`}>
                    {totalSelectedRoles} / {playerCount}
                  </span>
                </div>
                
                <button
                  onClick={startGame}
                  disabled={totalSelectedRoles !== playerCount}
                  className={`w-full py-4 rounded-xl font-bold text-lg transition-all flex items-center justify-center space-x-2 ${
                    totalSelectedRoles === playerCount 
                      ? 'bg-gradient-to-r from-purple-600 to-indigo-600 hover:opacity-90 shadow-lg shadow-purple-600/30' 
                      : 'bg-slate-800 text-slate-500 cursor-not-allowed'
                  }`}
                >
                  <span>Démarrer la partie</span>
                  {totalSelectedRoles === playerCount && <Play className="w-5 h-5 fill-current" />}
                </button>
              </div>
            </div>
          </div>
        )}

        {/* VUE : DISTRIBUTION */}
        {gameState === 'DISTRIBUTION' && (
          <DistributionPhase 
            role={shuffledRoles[currentPlayerIndex]} 
            playerNumber={currentPlayerIndex + 1}
            totalPlayers={shuffledRoles.length}
            onNext={nextPlayer}
          />
        )}

        {/* VUE : TABLEAU DE BORD NARRATEUR */}
        {gameState === 'DASHBOARD' && (
          <NarratorDashboard 
            initialRoles={shuffledRoles} 
            onReset={resetGame} 
          />
        )}

      </main>
    </div>
  );
}

