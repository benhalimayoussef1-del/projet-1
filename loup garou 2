                  >
                    <Minus className="w-4 h-4" />
                  </button>
                  <span className="text-xl font-bold w-6 text-center">{playerCount}</span>
                  <button 
                    onClick={() => setPlayerCount(p => p + 1)}
                    className="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition"
                  >
                    <Plus className="w-4 h-4" />
                  </button>
                </div>
              </div>
            </div>

            <div className="flex-1 overflow-y-auto p-6 space-y-3 pb-48">
              <h3 className="text-sm font-semibold text-purple-300 uppercase tracking-wider mb-2">Choisir les rôles</h3>
              
              {AVAILABLE_ROLES.map((role) => {
                const count = rolesCount[role.id] || 0;
                const Icon = role.icon;
                const isSelected = count > 0;
                
                return (
                  <div key={role.id} className={`flex items-center justify-between p-3 rounded-xl border transition-all ${isSelected ? 'bg-white/10 border-purple-500/50' : 'bg-slate-900/40 border-white/5'}`}>
                    <div className="flex items-center space-x-3">
                      <div className={`p-2 rounded-lg ${isSelected ? role.bg : 'bg-white/5'}`}>
                        <Icon className={`w-5 h-5 ${isSelected ? role.color : 'text-slate-500'}`} />
                      </div>
                      <span className={`font-medium ${isSelected ? 'text-white' : 'text-slate-400'}`}>
