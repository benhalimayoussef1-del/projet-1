                      </span>
                    </div>
                    
                    <div className="flex items-center space-x-3">
                      <button 
                        onClick={() => handleDecrement(role.id)}
                        className={`w-7 h-7 rounded-full flex items-center justify-center transition-colors ${count > 0 ? 'bg-white/10 hover:bg-white/20 text-white' : 'bg-transparent text-transparent'}`}
                      >
