// --- COMPOSANT : TABLEAU DE BORD NARRATEUR ---
function NarratorDashboard({ initialRoles, onReset }) {
  const [phase, setPhase] = useState('NIGHT'); // NIGHT, DAY
  const [dayPhase, setDayPhase] = useState('SPEAKING'); // SPEAKING, VOTING
  const [turn, setTurn] = useState(1);
  
  // Générer les joueurs à partir des rôles distribués
  const [players, setPlayers] = useState(() =>
    initialRoles.map((role, idx) => ({
      id: idx + 1,
      name: `Joueur ${idx + 1}`,
      role: role,
      isAlive: true,
      isInfected: false,
      isSilenced: false,
    }))
  );

  // États des modules spéciaux
  const [witchPotions, setWitchPotions] = useState({ life: true, death: true });
  const [infectUsed, setInfectUsed] = useState(false);
  const [alienUsed, setAlienUsed] = useState(false);
  
  const [alienTarget, setAlienTarget] = useState('');
  const [alienRole, setAlienRole] = useState('');
  const [infectTarget, setInfectTarget] = useState('');
  const [silenceTarget, setSilenceTarget] = useState('');
  
  const [message, setMessage] = useState(null);
  
  // États du chronomètre (Jour - Tours de parole)
  const alivePlayers = players.filter(p => p.isAlive);
  const aliveCount = alivePlayers.length;
  
  const [currentSpeakerIndex, setCurrentSpeakerIndex] = useState(0);
  const [speakerBaseTime, setSpeakerBaseTime] = useState(60); // 60s par défaut
  const [timeLeft, setTimeLeft] = useState(60);
  const [isTimerRunning, setIsTimerRunning] = useState(false);

  useEffect(() => {
    let interval;
    if (isTimerRunning && timeLeft > 0) {
      interval = setInterval(() => setTimeLeft(t => t - 1), 1000);
    } else if (isTimerRunning && timeLeft <= 0) {
      if (phase === 'DAY' && dayPhase === 'SPEAKING') {
        handleNextSpeaker();
      } else {
        setIsTimerRunning(false);
      }
    }
    return () => clearInterval(interval);
  }, [isTimerRunning, timeLeft, phase, dayPhase, currentSpeakerIndex, aliveCount, speakerBaseTime]);

  const formatTime = (seconds) => {
    const m = Math.floor(seconds / 60);
    const s = seconds % 60;
    return `${m}:${s.toString().padStart(2, '0')}`;
  };

  const showMessage = (msg) => {
    setMessage(msg);
    setTimeout(() => setMessage(null), 4000);
  };

  const togglePhase = () => {
    if (phase === 'NIGHT') {
      setPhase('DAY');
      setDayPhase('SPEAKING');
      setCurrentSpeakerIndex(0);
      setTimeLeft(speakerBaseTime);
      setIsTimerRunning(false);
      showMessage("Le jour se lève. Le village se réveille et découvre les morts.");
    } else {
      setPhase('NIGHT');
      setTurn(t => t + 1);
      setPlayers(players.map(p => ({ ...p, isSilenced: false })));
      showMessage("La nuit tombe. Le village s'endort...");
    }
  };

  const handleNextSpeaker = () => {
    if (currentSpeakerIndex < aliveCount - 1) {
      setCurrentSpeakerIndex(prev => prev + 1);
      setTimeLeft(speakerBaseTime);
      setIsTimerRunning(true);
    } else {
      setDayPhase('VOTING');
      setIsTimerRunning(false);
    }
  };

  const adjustTime = (delta) => {
    if (!isTimerRunning) {
      setSpeakerBaseTime(t => Math.max(10, t + delta));
      setTimeLeft(t => Math.max(10, t + delta));
    }
  };

  const toggleAlive = (id) => {
    setPlayers(players.map(p => p.id === id ? { ...p, isAlive: !p.isAlive } : p));
  };

  const handleManualAliveChange = (delta) => {
    if (delta === -1) {
        // Tuer le premier vivant trouvé (en partant de la fin pour tuer les derniers joueurs)
        const pToKill = [...players].reverse().find(p => p.isAlive);
        if (pToKill) toggleAlive(pToKill.id);
    } else if (delta === 1) {
        // Ressusciter le premier mort trouvé
        const pToRevive = players.find(p => !p.isAlive);
        if (pToRevive) toggleAlive(pToRevive.id);
    }
  };

  const handleAlienGuess = () => {
    if (!alienTarget || !alienRole) return;
    const target = players.find(p => p.id === Number(alienTarget));
    if (target.role.id === alienRole) {
      setPlayers(players.map(p => p.id === target.id ? { ...p, isAlive: false } : p));
      showMessage(`Succès ! L'Alien a vu juste, ${target.name} meurt.`);
    } else {
      setPlayers(players.map(p => p.role.id === 'alien' ? { ...p, isAlive: false } : p));
      showMessage(`Échec de la suggestion ! L'Alien meurt sur le coup.`);
    }
    setAlienUsed(true);
  };

  const handleInfect = () => {
    if (!infectTarget) return;
    setPlayers(players.map(p => p.id === Number(infectTarget) ? { ...p, isInfected: true } : p));
    setInfectUsed(true);
    showMessage(`Le joueur infecté a rejoint les Loups-Garous.`);
  };

  const handleSilence = () => {
    if (!silenceTarget) return;
    setPlayers(players.map(p => p.id === Number(silenceTarget) ? { ...p, isSilenced: true } : p));
    showMessage(`Joueur réduit au silence par le Loup Noir.`);
  };

  const isRoleInGame = (roleId) => initialRoles.some(r => r.id === roleId);
  const currentAlivePlayer = alivePlayers[currentSpeakerIndex] || { name: "Joueur" };

  return (
    <div className="flex-1 flex flex-col h-full animate-in fade-in duration-500 relative">
      {/* Toast Notification */}
      {message && (
        <div className="absolute top-20 left-1/2 -translate-x-1/2 bg-slate-800 border border-purple-500/50 text-white px-5 py-3 rounded-full shadow-2xl z-50 animate-in slide-in-from-top-4 fade-in duration-300 flex items-center space-x-3 w-max max-w-[90%]">
           <AlertTriangle className="w-5 h-5 text-purple-400 shrink-0" />
           <span className="font-medium text-sm leading-tight">{message}</span>
        </div>
      )}

      {/* Header Sticky */}
      <div className="sticky top-0 p-4 border-b border-white/10 bg-slate-950/90 backdrop-blur-xl flex justify-between items-center z-10 shrink-0 shadow-lg">
         <div className="flex items-center space-x-3">
            <div className={`p-2 rounded-xl transition-colors ${phase === 'DAY' ? 'bg-amber-500/20 text-amber-400 shadow-[0_0_15px_rgba(251,191,36,0.2)]' : 'bg-indigo-500/20 text-indigo-400 shadow-[0_0_15px_rgba(99,102,241,0.2)]'}`}>
               {phase === 'DAY' ? <Sun className="w-6 h-6" /> : <Moon className="w-6 h-6" />}
            </div>
            <div>
               <h2 className="text-xl font-bold">{phase === 'DAY' ? 'Le Jour' : 'La Nuit'}</h2>
               <div className="flex items-center space-x-2 mt-0.5">
                 <span className="text-xs text-slate-400 font-medium">Tour {turn} • </span>
                 
                 {/* Suivi manuel des joueurs en vie */}
                 <div className="flex items-center space-x-1 bg-white/5 rounded-full px-1 py-0.5">
                   <button onClick={() => handleManualAliveChange(-1)} className="w-5 h-5 rounded-full flex items-center justify-center hover:bg-white/10 transition text-slate-300">
                     <Minus className="w-3 h-3" />
                   </button>
                   <span className="text-xs font-bold text-white w-3 text-center">{aliveCount}</span>
                   <button onClick={() => handleManualAliveChange(1)} className="w-5 h-5 rounded-full flex items-center justify-center hover:bg-white/10 transition text-slate-300">
                     <Plus className="w-3 h-3" />
                   </button>
                 </div>
               </div>
            </div>
         </div>
         <button 
            onClick={phase === 'DAY' && dayPhase === 'SPEAKING' ? () => setDayPhase('VOTING') : togglePhase} 
            className={`px-4 py-2 rounded-xl font-bold text-sm transition shadow-lg ${phase === 'DAY' ? 'bg-indigo-600 hover:bg-indigo-500 text-white' : 'bg-amber-600 hover:bg-amber-500 text-slate-900'}`}
         >
            {phase === 'DAY' && dayPhase === 'SPEAKING' ? 'Passer au vote' : phase === 'DAY' ? 'Coucher le village' : 'Réveiller le village'}
         </button>
      </div>

      <div className="flex-1 overflow-y-auto p-4 space-y-6 pb-12">
        
        {/* Module : Chronomètre de Jour (Tour de Parole) */}
        {phase === 'DAY' && dayPhase === 'SPEAKING' && (
          <div className="p-6 rounded-2xl bg-gradient-to-br from-indigo-900/30 to-slate-900/50 border border-indigo-500/30 text-center flex flex-col items-center space-y-4 shadow-xl relative overflow-hidden">
            
            <div className="absolute top-0 left-0 w-full h-1 bg-indigo-900/50">
               <div className="h-full bg-indigo-500 transition-all duration-1000" style={{ width: `${(timeLeft / speakerBaseTime) * 100}%` }}></div>
            </div>

            <h3 className="text-indigo-300 font-medium flex items-center space-x-2">
              <Users className="w-5 h-5" />
              <span>Tour de parole : {currentAlivePlayer.name}</span>
            </h3>
            <span className="text-xs text-indigo-400/70 font-bold bg-indigo-900/40 px-3 py-1 rounded-full border border-indigo-500/20">
              {currentSpeakerIndex + 1} sur {aliveCount}
            </span>
            
            <div className="flex items-center justify-center space-x-4">
              <button 
                onClick={() => adjustTime(-10)} 
                disabled={isTimerRunning} 
                className="p-3 rounded-full bg-indigo-900/50 hover:bg-indigo-800 transition disabled:opacity-30 text-indigo-300"
              >
                <Minus className="w-6 h-6" />
              </button>
              
              <div className="text-6xl font-black tabular-nums text-white drop-shadow-[0_0_15px_rgba(255,255,255,0.2)] tracking-tighter w-40 text-center">
                {formatTime(timeLeft)}
              </div>
              
              <button 
                onClick={() => adjustTime(10)} 
                disabled={isTimerRunning} 
                className="p-3 rounded-full bg-indigo-900/50 hover:bg-indigo-800 transition disabled:opacity-30 text-indigo-300"
              >
                <Plus className="w-6 h-6" />
              </button>
            </div>

            <div className="flex space-x-4 w-full pt-2">
               <button onClick={() => setIsTimerRunning(!isTimerRunning)} className="flex-1 py-3 rounded-xl font-bold bg-indigo-600 hover:bg-indigo-500 transition shadow-lg shadow-indigo-600/30 text-white flex justify-center items-center space-x-2">
                  {isTimerRunning ? <PauseCircle className="w-6 h-6" /> : <PlayCircle className="w-6 h-6" />}
                  <span>{isTimerRunning ? 'Pause' : 'Démarrer'}</span>
               </button>
               <button onClick={() => { handleNextSpeaker(); }} className="flex-1 py-3 rounded-xl font-bold bg-slate-700 hover:bg-slate-600 border border-slate-600 transition shadow-lg text-white flex justify-center items-center space-x-2">
                  <span>Suivant</span>
                  <ArrowRight className="w-5 h-5" />
               </button>
            </div>
          </div>
        )}

        {/* Module : Phase de Vote */}
        {phase === 'DAY' && dayPhase === 'VOTING' && (
          <div className="p-6 rounded-2xl bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-600 text-center flex flex-col items-center space-y-4 shadow-xl animate-in zoom-in-95 duration-300">
            <div className="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center mb-2">
               <Users className="w-6 h-6 text-slate-300" />
            </div>
            <h3 className="text-white font-bold text-xl">Le Village Vote</h3>
            <p className="text-sm text-slate-400 mb-4">Qui sera sacrifié ?</p>
            
            <button 
              onClick={() => { handleManualAliveChange(-1); togglePhase(); }} 
              className="w-full py-4 rounded-xl bg-red-600 hover:bg-red-500 text-white font-bold transition shadow-lg flex justify-center items-center space-x-2 border border-red-500/50"
            >
               <Skull className="w-5 h-5" />
               <span>Un joueur est éliminé (Majorité)</span>
            </button>
            <button 
              onClick={() => { togglePhase(); }} 
              className="w-full py-4 rounded-xl bg-slate-700 hover:bg-slate-600 text-white font-bold transition shadow-lg flex justify-center items-center space-x-2 border border-slate-500/50"
            >
               <Check className="w-5 h-5" />
               <span>Vote Nul / Passe (Aucun mort)</span>
            </button>
          </div>
        )}

        {/* Modules : Actions de Nuit */}
        {phase === 'NIGHT' && (
          <div className="space-y-4">
            <h3 className="text-lg font-bold text-white/90 border-b border-white/10 pb-2">Actions Spéciales</h3>
            
            {isRoleInGame('sorciere') && (
              <div className="p-4 rounded-xl bg-purple-900/20 border border-purple-500/30 space-y-3">
                <div className="flex items-center space-x-2">
                  <Wand2 className="w-5 h-5 text-purple-400" />
                  <h4 className="font-bold text-purple-300">Sorcière</h4>
                </div>
                <div className="flex space-x-2">
                  <button onClick={() => setWitchPotions(p => ({...p, life: false}))} disabled={!witchPotions.life} className={`flex-1 py-2 rounded-lg text-sm font-bold transition ${witchPotions.life ? 'bg-purple-600 hover:bg-purple-500 text-white shadow-lg' : 'bg-slate-800/50 text-slate-500 line-through'}`}>
                    {witchPotions.life ? "Potion de Vie" : "Vie utilisée"}
                  </button>
                  <button onClick={() => setWitchPotions(p => ({...p, death: false}))} disabled={!witchPotions.death} className={`flex-1 py-2 rounded-lg text-sm font-bold transition ${witchPotions.death ? 'bg-red-600 hover:bg-red-500 text-white shadow-lg' : 'bg-slate-800/50 text-slate-500 line-through'}`}>
                    {witchPotions.death ? "Potion de Mort" : "Mort utilisée"}
                  </button>
                </div>
              </div>
            )}

            {isRoleInGame('pere-infecte') && !infectUsed && (
               <div className="p-4 rounded-xl bg-green-900/20 border border-green-500/30 space-y-3">
                  <div className="flex items-center space-x-2">
                     <Bug className="w-5 h-5 text-green-400" />
                     <h4 className="font-bold text-green-300">Père Infecté</h4>
                  </div>
                  <div className="flex space-x-2">
                     <select value={infectTarget} onChange={e => setInfectTarget(e.target.value)} className="flex-1 bg-slate-900/80 border border-white/10 rounded-lg p-2 text-sm focus:border-green-500 outline-none text-white">
                        <option value="">Choisir victime...</option>
                        {players.filter(p => p.isAlive && !p.isInfected).map(p => <option key={p.id} value={p.id}>{p.name}</option>)}
                     </select>
                     <button onClick={handleInfect} className="bg-green-600 hover:bg-green-500 px-4 py-2 rounded-lg text-sm font-bold transition text-white">Infecter</button>
                  </div>
               </div>
            )}

            {isRoleInGame('loup-noir') && (
               <div className="p-4 rounded-xl bg-zinc-800/40 border border-zinc-500/30 space-y-3">
                  <div className="flex items-center space-x-2">
                     <VolumeX className="w-5 h-5 text-zinc-400" />
                     <h4 className="font-bold text-zinc-300">Loup Noir (Silence)</h4>
                  </div>
                  <div className="flex space-x-2">
                     <select value={silenceTarget} onChange={e => setSilenceTarget(e.target.value)} className="flex-1 bg-slate-900/80 border border-white/10 rounded-lg p-2 text-sm focus:border-zinc-500 outline-none text-white">
                        <option value="">Choisir cible...</option>
                        {players.filter(p => p.isAlive && !p.isSilenced).map(p => <option key={p.id} value={p.id}>{p.name}</option>)}
                     </select>
                     <button onClick={handleSilence} className="bg-zinc-600 hover:bg-zinc-500 px-4 py-2 rounded-lg text-sm font-bold transition text-white">Faire taire</button>
                  </div>
               </div>
            )}

            {isRoleInGame('alien') && !alienUsed && (
               <div className="p-4 rounded-xl bg-teal-900/20 border border-teal-500/30 space-y-3">
                  <div className="flex items-center space-x-2">
                     <Ghost className="w-5 h-5 text-teal-400" />
                     <h4 className="font-bold text-teal-300">Alien (Suggestion)</h4>
                  </div>
                  <div className="space-y-2">
                     <select value={alienTarget} onChange={e => setAlienTarget(e.target.value)} className="w-full bg-slate-900/80 border border-white/10 rounded-lg p-2 text-sm focus:border-teal-500 outline-none text-white">
                        <option value="">Cibler un joueur...</option>
                        {players.filter(p => p.isAlive && p.role.id !== 'alien').map(p => <option key={p.id} value={p.id}>{p.name}</option>)}
                     </select>
                     <select value={alienRole} onChange={e => setAlienRole(e.target.value)} className="w-full bg-slate-900/80 border border-white/10 rounded-lg p-2 text-sm focus:border-teal-500 outline-none text-white">
                        <option value="">Suggérer son rôle...</option>
                        {AVAILABLE_ROLES.filter(r => r.id !== 'alien').map(r => <option key={r.id} value={r.id}>{r.name}</option>)}
                     </select>
                     <button onClick={handleAlienGuess} disabled={!alienTarget || !alienRole} className="w-full bg-teal-600 hover:bg-teal-500 disabled:opacity-50 px-4 py-3 rounded-lg text-sm font-bold transition text-white mt-1 shadow-lg">
                        Tenter la suggestion
                     </button>
                  </div>
               </div>
            )}
          </div>
        )}

        {/* Module : État des Joueurs (Jour & Nuit) */}
        <div className="space-y-3">
          <h3 className="text-lg font-bold text-white/90 border-b border-white/10 pb-2">État du Village</h3>
          {players.map(player => (
             <div key={player.id} className={`p-3 rounded-xl border flex items-center justify-between transition-all ${player.isAlive ? 'bg-slate-800/80 border-slate-600' : 'bg-red-950/20 border-red-900/30 opacity-50'}`}>
                <div className="flex flex-col flex-1 min-w-0 pr-2">
                   <div className="flex items-center space-x-2">
                      <span className={`font-bold truncate ${player.isAlive ? 'text-white' : 'text-slate-500 line-through'}`}>
                        {player.name}
                      </span>
                      {player.isInfected && <Bug className="w-4 h-4 text-green-500 shrink-0" title="Infecté" />}
                      {player.isSilenced && <VolumeX className="w-4 h-4 text-zinc-400 shrink-0" title="Réduit au silence" />}
                   </div>
                   <div className="flex items-center space-x-1 mt-1">
                      <span className="text-sm">{player.role.emoji}</span>
                      <span className={`text-xs font-medium truncate ${player.role.color}`}>{player.role.name}</span>
                   </div>
                </div>
                
                <div className="flex items-center space-x-2 shrink-0">
                   {player.isAlive ? (
                      <>
                        {phase === 'DAY' && player.isSilenced && (
                           <button onClick={() => { toggleAlive(player.id); showMessage(`${player.name} a été exécuté(e) pour avoir brisé le silence.`); }} className="bg-red-600 hover:bg-red-500 px-3 py-2 rounded-lg text-xs font-bold transition shadow-lg text-white">
                              A parlé !
                           </button>
                        )}
                        <button onClick={() => toggleAlive(player.id)} className="bg-slate-700 hover:bg-red-900 p-3 rounded-lg transition text-white" title="Éliminer / Tuer">
                           <Skull className="w-4 h-4 text-red-300"/>
                        </button>
                      </>
                   ) : (
                      <button onClick={() => toggleAlive(player.id)} className="bg-slate-900 hover:bg-green-900 border border-slate-700 p-3 rounded-lg transition text-white" title="Ressusciter (Erreur / Potion)">
                         <HeartPulse className="w-4 h-4 text-green-400"/>
                      </button>
                   )}
                </div>
             </div>
          ))}
        </div>
        
        {/* Footer actions */}
        <div className="pt-8 flex justify-center pb-8">
           <button onClick={onReset} className="px-6 py-3 rounded-xl bg-slate-900 hover:bg-red-950 border border-slate-700 hover:border-red-900/50 text-slate-400 hover:text-red-400 font-bold text-sm transition flex items-center space-x-2">
              <RotateCcw className="w-4 h-4" />
              <span>Terminer la partie</span>
           </button>
        </div>

      </div>
    </div>
  );
}
